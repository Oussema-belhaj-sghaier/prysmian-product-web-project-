{% extends 'base.html.twig' %}
{% block title %}{{ moduleTitle }} | Prysmian Tunisia{% endblock %}
{% block body %}
<style>
.module-head{display:flex;justify-content:space-between;align-items:end;gap:1rem;margin-bottom:1.5rem}.module-head h1{margin:.3rem 0 0;font-size:2rem;letter-spacing:-.04em}.module-head p{color:#657079;margin:.4rem 0 0}.module-card{background:#fff;border:1px solid #e3e7e8;border-radius:12px;box-shadow:0 8px 24px #1d2b3510;overflow:hidden}.card-head{display:flex;justify-content:space-between;align-items:center;padding:1.1rem 1.25rem;border-bottom:1px solid #edf0f1}.card-head h2{margin:0;font-size:1rem}.primary-button{border:0;border-radius:8px;padding:.7rem 1rem;background:#d94841;color:#fff;font-weight:800;cursor:pointer}.data-table{width:100%;border-collapse:collapse;font-size:.84rem}.data-table th{padding:.75rem 1rem;background:#fafbfb;color:#77828a;text-align:left;font-size:.7rem;text-transform:uppercase;letter-spacing:.08em}.data-table td{padding:.85rem 1rem;border-top:1px solid #f0f2f2}.data-table tr:hover{background:#fcf7f6}.product-thumb{width:48px;height:48px;object-fit:cover;border-radius:8px;vertical-align:middle}.code{font-family:Consolas,monospace;font-size:.78rem;font-weight:700}.badge{display:inline-flex;border-radius:999px;padding:.28rem .55rem;font-size:.68rem;font-weight:800}.good{color:#16704b;background:#e4f5ec}.warn{color:#996019;background:#fff1d7}.danger{color:#a3312c;background:#fde5e3}.neutral{color:#5e6a70;background:#edf0f1}.actions{display:flex;gap:.4rem;white-space:nowrap}.small-button{padding:.4rem .6rem;border:1px solid #d7dddf;border-radius:6px;background:#fff;cursor:pointer;font-size:.72rem;font-weight:800}.empty{text-align:center;color:#7c878d;padding:2rem}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem}.alert-list{padding:1.1rem;display:grid;gap:.75rem}.alert-item{padding:.8rem;border-left:3px solid #e1a33a;border-radius:7px;background:#fafbfb}.alert-item strong,.alert-item small{display:block}.alert-item small{color:#77828a;margin-top:.25rem}.modal-overlay{display:none;position:fixed;inset:0;z-index:500;align-items:center;justify-content:center;padding:1rem;background:#1d2b3588}.modal-overlay.open{display:flex}.modal-content{width:min(700px,100%);max-height:90vh;overflow:auto;background:#fff;border-radius:12px;padding:1.5rem}.modal-close{float:right;border:0;border-radius:50%;width:32px;height:32px;cursor:pointer}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.form-full{grid-column:1/-1}.field label{display:block;margin-bottom:.35rem;color:#59656c;font-size:.7rem;font-weight:800;text-transform:uppercase}.field input,.field select,.field textarea{width:100%;padding:.7rem;border:1px solid #d7dddf;border-radius:7px;font:inherit}.form-actions{display:flex;justify-content:flex-end;gap:.6rem;margin-top:1.25rem}@media(max-width:700px){.module-head{align-items:start;flex-direction:column}.grid{grid-template-columns:1fr}.form-grid{grid-template-columns:1fr}.form-full{grid-column:auto}.data-table{min-width:700px}.module-card>div:has(.data-table){overflow:auto}}
</style>
<div class="module-head"><div><div class="eyebrow">Prysmian Tunisia · espace métier</div><h1>{{ moduleTitle }}</h1><p>Un espace dédié pour consulter et gérer vos opérations.</p></div>{% if module == 'catalogue' %}<button class="primary-button" onclick="openProductModal()">+ Nouvelle référence</button>{% elseif module == 'production' %}<button class="primary-button" onclick="openOrderModal()">+ Nouvel ordre</button>{% elseif module == 'users' %}<button class="primary-button" onclick="openUserModal()">+ Nouvel utilisateur</button>{% endif %}</div>
{% if module == 'catalogue' %}<section class="module-card"><div class="card-head"><h2>Références fabriquées</h2><span>{{ cables|length }} produit(s)</span></div><div style="overflow:auto"><table class="data-table"><thead><tr><th>Produit</th><th>Désignation</th><th>Famille</th><th>Stock</th><th>Usine</th><th>Statut</th><th>Actions</th></tr></thead><tbody>{% for cable in cables %}<tr><td><img class="product-thumb" src="{{ cable.imagePath ?: '/images/product-default.svg' }}" alt="{{ cable.designation }}"> <span class="code">{{ cable.referenceCode }}</span></td><td>{{ cable.designation }}</td><td>{{ cable.cableType.value }}</td><td>{{ cable.stockMeters|number_format(0, ',', ' ') }} m</td><td>{{ cable.factory ?: '—' }}</td><td><span class="badge {{ cable.status.value == 'IN_STOCK' ? 'good' : (cable.status.value == 'QC_HOLD' ? 'danger' : 'warn') }}">{{ cable.status.value|replace({'_':' '}) }}</span></td><td><div class="actions"><button class="small-button" onclick="openProductModal('{{ cable.id }}')">Modifier</button><form method="post" action="/cable/{{ cable.id }}/delete" onsubmit="return confirm('Supprimer cette référence ?')"><button class="small-button" type="submit">Supprimer</button></form></div></td></tr>{% else %}<tr><td class="empty" colspan="7">Aucun produit enregistré.</td></tr>{% endfor %}</tbody></table></div></section>
{% elseif module == 'production' %}<section class="module-card"><div class="card-head"><h2>Suivi des ordres</h2><span>{{ maintenances|length }} ordre(s)</span></div><div style="overflow:auto"><table class="data-table"><thead><tr><th>Ordre</th><th>Produit</th><th>Étape</th><th>Début</th><th>Coût</th><th>État</th><th>Action</th></tr></thead><tbody>{% for order in maintenances %}<tr><td class="code">{{ order.orderNumber ?: 'OF-' ~ order.id|slice(0,6) }}</td><td>{{ order.cable.referenceCode }}</td><td>{{ order.maintenanceType.value }}</td><td>{{ order.startDate|date('d/m/Y H:i') }}</td><td>{{ order.cost|number_format(2,',',' ') }} TND</td><td><span class="badge {{ order.resultStatus.value == 'DONE' ? 'good' : (order.resultStatus.value == 'REJECTED' ? 'danger' : 'warn') }}">{{ order.resultStatus.value|replace({'_':' '}) }}</span></td><td><form method="post" action="/maintenance/{{ order.id }}/delete"><button class="small-button">Supprimer</button></form></td></tr>{% else %}<tr><td class="empty" colspan="7">Aucun ordre.</td></tr>{% endfor %}</tbody></table></div></section>
{% elseif module == 'quality' %}<div class="grid">{% if qualityView in ['all','alerts'] %}<section class="module-card"><div class="card-head"><h2>Alertes qualité</h2><span>{{ alerts|length }}</span></div><div class="alert-list">{% for alert in alerts %}<div class="alert-item"><strong>{{ alert.alertType.value }} · {{ alert.cable.referenceCode }}</strong><small>{{ alert.message }}<br>{{ alert.createdAt|date('d/m/Y H:i') }}</small></div>{% else %}<div class="empty">Aucune alerte.</div>{% endfor %}</div></section>{% endif %}{% if qualityView in ['all','analysis'] %}<section class="module-card"><div class="card-head"><h2>Analyses prédictives</h2><span>{{ predictions|length }}</span></div><div class="alert-list">{% for prediction in predictions %}<div class="alert-item" style="border-color:#51788d"><strong>{{ prediction.cable.referenceCode }} · {{ (prediction.confidenceScore * 100)|round }}%</strong><small>{{ prediction.reason }}<br>Échéance : {{ prediction.predictedDate|date('d/m/Y') }}</small></div>{% else %}<div class="empty">Aucune analyse.</div>{% endfor %}</div></section>{% endif %}</div>
{% elseif module == 'users' %}<section class="module-card"><div class="card-head"><h2>Comptes et rôles</h2><span>{{ users|length }} utilisateur(s)</span></div><div style="overflow:auto"><table class="data-table"><thead><tr><th>Photo</th><th>Nom</th><th>Email</th><th>Rôle</th><th>Atelier</th><th>Statut</th><th>Actions</th></tr></thead><tbody>{% for member in users %}<tr><td>{% if member.profileImagePath %}<img src="{{ member.profileImagePath }}" alt="Photo de {{ member.fullName }}" style="width:40px;height:40px;border-radius:50%;object-fit:cover">{% else %}<span style="display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:50%;background:#f9e8e6;color:#b93631;font-weight:900">{{ member.firstName|first }}{{ member.lastName|first }}</span>{% endif %}</td><td><strong>{{ member.fullName }}</strong></td><td>{{ member.email }}</td><td>{{ member.role.value }}</td><td>{{ member.regionAssigned ?: 'Tous ateliers' }}</td><td><span class="badge {{ member.status.value == 'ACTIVE' ? 'good' : 'neutral' }}">{{ member.status.value }}</span></td><td><div class="actions"><button class="small-button" onclick="openUserModal('{{ member.id }}')">Modifier</button><form method="post" action="/user/{{ member.id }}/delete"><button class="small-button">Supprimer</button></form></div></td></tr>{% else %}<tr><td class="empty" colspan="7">Aucun utilisateur.</td></tr>{% endfor %}</tbody></table></div></section>{% endif %}
{% if module == 'catalogue' %}<div id="productModal" class="modal-overlay"><div class="modal-content"><button class="modal-close" onclick="closeProductModal()">×</button><h2>Nouvelle référence</h2><form method="post" action="{{ path('app_cable_create') }}" enctype="multipart/form-data"><div class="form-grid"><div class="field"><label>Référence</label><input name="referenceCode" required></div><div class="field"><label>Désignation</label><input name="designation" required></div><div class="field"><label>Famille</label><select name="cableType"><option>HT</option><option>MT</option><option>BT</option><option>FIBER</option><option>SUBMARINE</option><option>SPECIAL</option></select></div><div class="field"><label>Statut</label><select name="status"><option>IN_STOCK</option><option>IN_PRODUCTION</option><option>QC_HOLD</option><option>OUT_OF_STOCK</option><option>DISCONTINUED</option></select></div><div class="field"><label>Stock mètres</label><input name="stockMeters" type="number" min="0"></div><div class="field"><label>Usine</label><input name="factory" value="Usine Bizerte"></div><div class="field"><label>Photo produit</label><input name="image" type="file" accept="image/jpeg,image/png,image/webp"></div><div class="field form-full"><label>Description</label><textarea name="description" rows="3"></textarea></div></div><div class="form-actions"><button type="button" class="small-button" onclick="closeProductModal()">Annuler</button><button class="primary-button">Enregistrer</button></div></form></div></div><script>function openProductModal(){document.getElementById('productModal').classList.add('open')}function closeProductModal(){document.getElementById('productModal').classList.remove('open')}</script>{% elseif module == 'production' %}<div id="orderModal" class="modal-overlay"><div class="modal-content"><button class="modal-close" onclick="closeOrderModal()">×</button><h2>Nouvel ordre de fabrication</h2><form method="post" action="{{ path('app_maintenance_create') }}"><div class="form-grid"><div class="field form-full"><label>Produit</label><select name="cableId" required>{% for cable in cables %}<option value="{{ cable.id }}">{{ cable.referenceCode }} · {{ cable.designation }}</option>{% endfor %}</select></div><div class="field"><label>Étape</label><select name="maintenanceType"><option>EXTRUSION</option><option>STRANDING</option><option>ARMORING</option><option>TESTING</option><option>PACKAGING</option></select></div><div class="field"><label>Statut</label><select name="resultStatus"><option>PLANNED</option><option>IN_PROGRESS</option><option>QC_CHECK</option><option>DONE</option></select></div><div class="field"><label>N° ordre</label><input name="orderNumber"></div><div class="field"><label>Longueur cible</label><input name="targetLengthMeters" type="number" min="0"></div><div class="field"><label>Coût TND</label><input name="cost" type="number" min="0" step=".01"></div><div class="field form-full"><label>Instructions</label><textarea name="description" rows="3" required></textarea></div></div><div class="form-actions"><button type="button" class="small-button" onclick="closeOrderModal()">Annuler</button><button class="primary-button">Créer</button></div></form></div></div><script>function openOrderModal(){document.getElementById('orderModal').classList.add('open')}function closeOrderModal(){document.getElementById('orderModal').classList.remove('open')}</script>{% elseif module == 'users' %}<div id="userModal" class="modal-overlay"><div class="modal-content"><button class="modal-close" onclick="closeUserModal()">×</button><h2>Nouvel utilisateur</h2><form method="post" action="{{ path('app_user_create') }}" enctype="multipart/form-data"><div class="form-grid"><div class="field"><label>Prénom</label><input name="firstName" required></div><div class="field"><label>Nom</label><input name="lastName" required></div><div class="field form-full"><label>Email</label><input name="email" type="email" required></div><div class="field"><label>Rôle</label><select name="role"><option>TECHNICIAN</option><option>SUPERVISOR</option><option>ADMIN</option></select></div><div class="field"><label>Atelier</label><input name="regionAssigned"></div><div class="field"><label>Téléphone</label><input name="phone"></div><div class="field"><label>Photo de profil</label><input name="profileImage" type="file" accept="image/jpeg,image/png,image/webp"></div></div><div class="form-actions"><button type="button" class="small-button" onclick="closeUserModal()">Annuler</button><button class="primary-button">Créer</button></div></form></div></div><script>function openUserModal(){document.getElementById('userModal').classList.add('open')}function closeUserModal(){document.getElementById('userModal').classList.remove('open')}</script>{% endif %}
{% if module == 'catalogue' %}<script>const cableStatusLabels={IN_STOCK:'En stock',IN_PRODUCTION:'En production',QC_HOLD:'Contrôle qualité',OUT_OF_STOCK:'Rupture de stock',DISCONTINUED:'Arrêté'};document.querySelectorAll('.data-table tbody .badge').forEach(badge=>{badge.textContent=cableStatusLabels[badge.textContent.trim()]||badge.textContent});document.querySelectorAll('select[name="status"] option').forEach(option=>{option.textContent=cableStatusLabels[option.value]||option.textContent})</script>{% endif %}
{% if module == 'catalogue' %}<script>const catalogueProducts={{ productData|json_encode|raw }};function openProductModal(id){const product=catalogueProducts.find(item=>item.id===id);const modal=document.getElementById('productModal');const form=modal.querySelector('form');const title=modal.querySelector('h2');title.textContent=product?'Modifier la référence':'Nouvelle référence';form.action=product?'/cable/'+id+'/edit':'{{ path('app_cable_create') }}';form.elements.referenceCode.value=product?.reference||'';form.elements.designation.value=product?.designation||'';form.elements.cableType.value=product?.type||'MT';form.elements.status.value=product?.status||'IN_STOCK';form.elements.stockMeters.value=product?.stock??'';form.elements.factory.value=product?.factory||'';form.elements.description.value=product?.description||'';modal.classList.add('open')}</script>{% endif %}
{% if module == 'catalogue' %}<script>const cableStatusValues={'En stock':'IN_STOCK','En production':'IN_PRODUCTION','Contrôle qualité':'QC_HOLD','Rupture de stock':'OUT_OF_STOCK','Arrêté':'DISCONTINUED'};document.querySelectorAll('select[name="status"] option').forEach(option=>{if(cableStatusValues[option.textContent.trim()])option.value=cableStatusValues[option.textContent.trim()]})</script>{% endif %}
{% if module == 'catalogue' %}<script>const catalogueTable=document.querySelector('.data-table');if(catalogueTable){const catalogueRows=[...catalogueTable.querySelectorAll('tbody tr')].filter(row=>row.cells.length===7);const selectionForm=document.createElement('form');selectionForm.method='post';selectionForm.action='{{ path('app_cable_bulk_delete') }}';const toolbar=document.createElement('div');toolbar.style='display:flex;justify-content:flex-end;align-items:center;gap:.7rem;padding:.8rem 1rem;border-bottom:1px solid #edf0f1';const selectAll=document.createElement('input');selectAll.type='checkbox';selectAll.title='Sélectionner tous les produits';const selectAllLabel=document.createElement('label');selectAllLabel.style='display:flex;align-items:center;gap:.4rem;color:#59656c;font-size:.78rem';selectAllLabel.append(selectAll,'Tout sélectionner');const deleteButton=document.createElement('button');deleteButton.type='submit';deleteButton.textContent='Supprimer la sélection';deleteButton.style='border:1px solid #c94a45;border-radius:7px;padding:.55rem .75rem;background:#fff;color:#a3312c;font-weight:800;cursor:pointer';deleteButton.disabled=true;toolbar.append(selectAllLabel,deleteButton);catalogueTable.parentElement.insertBefore(toolbar,catalogueTable);selectionForm.style='display:none';document.body.append(selectionForm);const headerCell=catalogueTable.tHead.rows[0].insertCell(0);headerCell.append(selectAll.cloneNode(true));const headerSelectAll=headerCell.firstElementChild;catalogueRows.forEach(row=>{const cell=row.insertCell(0);const checkbox=document.createElement('input');checkbox.type='checkbox';checkbox.value=row.querySelector('form[action*="/cable/"]').action.split('/cable/')[1].split('/')[0];checkbox.className='catalogue-selection';cell.append(checkbox);checkbox.addEventListener('change',syncSelection)});function syncSelection(){const selected=[...catalogueTable.querySelectorAll('.catalogue-selection:checked')];deleteButton.disabled=selected.length===0;selectAll.checked=selected.length>0&&selected.length===catalogueRows.length;headerSelectAll.checked=selectAll.checked}function toggleAll(checked){catalogueTable.querySelectorAll('.catalogue-selection').forEach(checkbox=>{checkbox.checked=checked});syncSelection()}selectAll.addEventListener('change',event=>toggleAll(event.target.checked));headerSelectAll.addEventListener('change',event=>toggleAll(event.target.checked));selectionForm.addEventListener('submit',event=>{const selected=[...catalogueTable.querySelectorAll('.catalogue-selection:checked')];if(selected.length===0||!confirm('Supprimer les produits sélectionnés ?')){event.preventDefault();return}selected.forEach(checkbox=>{const input=document.createElement('input');input.type='hidden';input.name='ids[]';input.value=checkbox.value;selectionForm.append(input)})})}}</script>{% endif %}
{% if module == 'catalogue' %}<script>const bulkDeleteForm=[...document.querySelectorAll('form')].find(form=>form.style.display==='none');const bulkDeleteButton=[...document.querySelectorAll('button[type="submit"]')].find(button=>button.textContent.trim()==='Supprimer la sélection');if(bulkDeleteForm&&bulkDeleteButton){bulkDeleteForm.id='bulkDeleteForm';bulkDeleteButton.setAttribute('form','bulkDeleteForm')}</script>{% endif %}
{% if module == 'catalogue' %}<script>const filterTable=document.querySelector('.data-table');if(filterTable){const filterBar=document.createElement('div');filterBar.style='display:flex;flex-wrap:wrap;gap:.6rem;padding:.8rem 1rem;border-bottom:1px solid #edf0f1';filterBar.innerHTML='<input id="catalogueSearch" type="search" placeholder="Rechercher une référence, désignation ou usine..." style="flex:1;min-width:220px;border:1px solid #d7dddf;border-radius:7px;padding:.6rem .7rem"><select id="catalogueFamily" style="border:1px solid #d7dddf;border-radius:7px;padding:.6rem .7rem"><option value="">Toutes les familles</option><option value="HT">Haute tension</option><option value="MT">Moyenne tension</option><option value="BT">Basse tension</option><option value="FIBER">Fibre optique</option><option value="SUBMARINE">Sous-marin</option><option value="SPECIAL">Spécial industriel</option></select><select id="catalogueStatus" style="border:1px solid #d7dddf;border-radius:7px;padding:.6rem .7rem"><option value="">Tous les statuts</option><option value="En stock">En stock</option><option value="En production">En production</option><option value="Contrôle qualité">Contrôle qualité</option><option value="Rupture de stock">Rupture de stock</option><option value="Arrêté">Arrêté</option></select>';filterTable.parentElement.insertBefore(filterBar,filterTable);const searchInput=document.getElementById('catalogueSearch');const familySelect=document.getElementById('catalogueFamily');const statusSelect=document.getElementById('catalogueStatus');function applyCatalogueFilters(){const query=searchInput.value.trim().toLowerCase();const family=familySelect.value.toLowerCase();const status=statusSelect.value.toLowerCase();filterTable.querySelectorAll('tbody tr').forEach(row=>{if(row.cells.length<7)return;const text=row.textContent.toLowerCase();const rowFamily=row.cells[3].textContent.trim().toLowerCase();const rowStatus=row.cells[6].textContent.trim().toLowerCase();row.style.display=(!query||text.includes(query))&&(!family||rowFamily===family)&&(!status||rowStatus===status)?'':'none'})}searchInput.addEventListener('input',applyCatalogueFilters);familySelect.addEventListener('change',applyCatalogueFilters);statusSelect.addEventListener('change',applyCatalogueFilters)}};</script>{% endif %}
{% endblock %}
